{
    "name": "fyre/framework",
    "description": "FyrePHP framework for MVC web apps with PSR-compliant HTTP, routing, ORM, cache, queue, and CLI tooling.",
    "keywords": [
        "framework",
        "fyre",
        "fyrephp",
        "php",
        "mvc",
        "psr",
        "psr-7",
        "psr-11",
        "psr-15",
        "psr-17",
        "http",
        "router",
        "orm",
        "cache",
        "queue",
        "console",
        "email"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "elusivecodes",
            "email": "elusivecodes@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.5",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-sodium": "*",
        "psr/container": "^2.0",
        "psr/event-dispatcher": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^3.0",
        "psr/simple-cache": "^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.91",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13"
    },
    "provide": {
        "psr/container-implementation": "^2.0",
        "psr/event-dispatcher-implementation": "^1.0",
        "psr/http-client-implementation": "^1.0",
        "psr/http-factory-implementation": "^1.0",
        "psr/http-message-implementation": "^2.0",
        "psr/http-server-handler-implementation": "^1.0",
        "psr/http-server-middleware-implementation": "^1.0",
        "psr/log-implementation": "^3.0",
        "psr/simple-cache-implementation": "^3.0"
    },
    "autoload": {
        "files": [
            "src/functions.php"
        ],
        "psr-4": {
            "Fyre\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "suggest": {
        "ext-curl": "Required to use client requests.",
        "ext-exif": "Required to detect EXIF orientation for image manipulation.",
        "ext-gd": "Required to use image manipulation.",
        "ext-memcached": "Required to use Memcached cache handler.",
        "ext-openssl": "Required to use OpenSSL encryption handler.",
        "ext-pcntl": "Required to use queue workers and async promises.",
        "ext-pdo": "Required to use database connections.",
        "ext-posix": "Required to use async promises.",
        "ext-redis": "Required to use Redis cache and queue handlers.",
        "ext-sockets": "Required to use async promises.",
        "friendsofphp/php-cs-fixer": "Required to use Fyre\\TestSuite\\PhpCsFixer\\Config.",
        "phpstan/phpstan": "Required to use Fyre\\TestSuite\\PhpStan extensions.",
        "phpunit/phpunit": "Required to use Fyre\\TestSuite\\TestCase, traits, and constraints."
    },
    "config": {
        "lock": false,
        "sort-packages": true
    },
    "scripts": {
        "cs": "php-cs-fixer fix --ansi --verbose --dry-run --diff",
        "cs:fix": "php-cs-fixer fix --ansi --verbose --diff",
        "stan": "phpstan analyse",
        "stan:tests": "phpstan analyse -c tests/phpstan.neon",
        "test:core": "phpunit --testsuite core",
        "test:mysql": "phpunit --testsuite mysql",
        "test:mariadb": "phpunit --testsuite mariadb",
        "test:postgres": "phpunit --testsuite postgres",
        "test:sqlite": "phpunit --testsuite sqlite",
        "test:redis": "phpunit --testsuite redis",
        "test:memcached": "phpunit --testsuite memcached",
        "test:smtp": "phpunit --testsuite smtp",
        "test:external": "phpunit --testsuite external",
        "test": "phpunit",
        "test:coverage": "XDEBUG_MODE=coverage phpunit --coverage-html coverage_report --coverage-clover coverage.xml"
    }
}
